# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
.eggs/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/

# Environment variables
.env

# Type checking / linting caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
*.ipynb_checkpoints/

# macOS
.DS_Store

# Model checkpoints and weights
*.pt
*.pth
*.ckpt

# Data directory (downloaded datasets)
/data/

# Downloaded reading PDFs (too large for git)
static/readings/

# Experiment tracking
wandb/
runs/

# Streamlit config (keep config.toml, ignore cache)
.streamlit/*
!.streamlit/config.toml

# Claude Code
.claude/
